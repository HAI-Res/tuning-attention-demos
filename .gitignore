# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Fetched at runtime; the *.local-ip.sh key is public but there is no reason
# to commit a TLS key, and it is re-downloaded automatically.
certs/

.claude/

# MediaPipe model bundles: fetched with `uv run fetch-models`, ~30 MB, not source.
models/
*.task

# Camera recordings
recordings/
*.mp4

# Audio used as source material — not ours to redistribute, and large.
patches/max/*.wav
patches/max/*.aif
patches/max/*.aiff

# OS and editor cruft
.DS_Store

# Screen recordings and generated audio dropped into the repo root by habit,
# not source material anyone should pull.
*.mov
flowedit_out/
samples/
